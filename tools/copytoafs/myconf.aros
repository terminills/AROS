#! /bin/sh
# Probe the build host with its configured compiler, including SDK flags.
set -e
probe=$1/myctest
shift
trap 'rm -f "$probe.c" "$probe"' 0
cat >"$probe.c" <<'END'
#include <stdint.h>
#include <stdio.h>

int main(void)
{
    const uint32_t value = 1;
    /* AFS uses fixed-width types; host long need not be 32 bits. */
    if (*(const unsigned char *)&value == 1)
        puts("#ifndef LITT_ENDIAN\n#define LITT_ENDIAN 1\n#endif");
    return 0;
}
END
"$@" "$probe.c" -o "$probe"
"$probe"
