+// PIPE: has no ChangeMode-based O_NONBLOCK. Registered DOS pipes use
+// uv1's existing WaitForChar readiness and read wrapper instead, as do
+// pipes created by uv_spawn. Only pipes created below take this path.
+extern "C" int __wrap_uv_pipe_open(uv_pipe_t* handle, uv_file fd)
+{
+  if (!uv__aros_is_dos_pipe(fd)) return __real_uv_pipe_open(handle, fd);
+  int mode = fcntl(fd, F_GETFL);
+  if (mode < 0) return UV_EBADF;
+  // These flags are from uv-common.h in the matching uv1 build.
+  constexpr int readable = 0x00004000;
+  constexpr int writable = 0x00008000;
+  int flags = 0;
+  if ((mode & O_ACCMODE) != O_WRONLY) flags |= readable;
+  if ((mode & O_ACCMODE) != O_RDONLY) flags |= writable;
+  return uv__stream_open(reinterpret_cast<uv_stream_t*>(handle), fd, flags);
+}
