@@ -0,0 +1,9 @@
+/* CMake is a noninteractive POSIX command: missing volume paths must
+ * return errors, not block unattended builds with DOS requesters. */
+#include <proto/exec.h>
+#include <dos/dosextens.h>
+void cmArosDisableRequesters(void)
+{
+  struct Process *process = (struct Process *)FindTask(NULL);
+  process->pr_WindowPtr = (APTR)-1;
+}
