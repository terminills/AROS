LIBUVVERSION := 1.48.0
ARCHBASE     := libuv
# The libuv tarball's internal top dir (libuv-v<ver>) is not stripped by %fetch,
# so point ARCHSRCDIR at the real unpacked location.
ARCHSRCDIR   := $(PORTSDIR)/libuv/libuv/libuv-v$(LIBUVVERSION)

# libuv core-first (no socket layer yet): satisfy uv/unix.h's network TYPE
# includes from bsdsocket's headers -- the non-networking core (loop, timer,
# async, threadpool, fs) references struct sockaddr et al only in declarations,
# so compiling needs the headers, NOT a socket implementation. pthread.h and
# semaphore.h come from compiler/pthread.
LIBUV_CPPFLAGS := -D_GNU_SOURCE -DUV_AROS_INTERNAL_BUILD \
                  -include $(SRCDIR)/$(CURDIR)/aros-compat.h
# Port-local headers AROS lacks (poll.h etc) -- must precede the tarball/network
# include dirs.
USER_INCLUDES += -idirafter $(SRCDIR)/$(CURDIR)/include-aros
USER_INCLUDES += -idirafter $(ARCHSRCDIR)/include
USER_INCLUDES += -idirafter $(ARCHSRCDIR)/src
USER_INCLUDES += -idirafter $(ARCHSRCDIR)/src/unix
USER_INCLUDES += -idirafter $(SRCDIR)/workbench/network/common/include
USER_INCLUDES += -idirafter $(SRCDIR)/compiler/pthread
