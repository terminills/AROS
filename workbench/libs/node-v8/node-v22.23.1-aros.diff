@@ -135,0 +139,13 @@ static void GetTempDir(const FunctionCallbackInfo<Value>& args) {
+#ifdef __AROS__
+  // POSIXC may expose the native T: assignment as /T, /T/, or /T:/... .
+  // Returning that spelling to Node callers eventually sends it back to DOS,
+  // where it is interpreted as a request for a volume literally named "/T".
+  if (dir == "/T" || dir == "/T/") {
+    dir = "T:";
+  } else if (dir.starts_with("/T:/")) {
+    dir.erase(0, 1);
+  } else if (dir.starts_with("/T/")) {
+    dir.replace(0, 3, "T:");
+  }
+#endif
+
