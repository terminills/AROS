include $(SRCDIR)/config/aros.cfg

FILES := uvc

# Needs the genmodule-generated VHI includes (<vhi/vhi.h> proto/defines) and the
# Poseidon includes (<proto/poseidon.h> for camera enumeration).
#MM- workbench-libs-vhi-uvc : workbench-libs-vhi-includes kernel-usb-poseidon-includes

%build_module_library mmake=workbench-libs-vhi-uvc \
    modname=uvc modtype=library linklibname=uvcvideo \
    files="$(FILES)"

%common
