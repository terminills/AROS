
include $(SRCDIR)/config/aros.cfg

FILES := application_apps application_notify

USER_LDFLAGS := -static

#MM- workbench-libs : workbench-libs-application
%build_module mmake=workbench-libs-application \
    modname=application modtype=library \
    files="application_init $(FILES)"

#MM includes-copy
INCLUDE_FILES := $(call WILDCARD, include/*.h)
%copy_includes path=libraries dir=include

%common
