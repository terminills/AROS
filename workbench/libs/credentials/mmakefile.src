
include $(SRCDIR)/config/aros.cfg

FILES := credentials_identity credentials_keyring credentials_crypto

USER_CPPFLAGS := -DADEBUG=1
USER_LDFLAGS := -static

# Keyring sealing uses embedded reference crypto (credentials_crypto.c:
# ChaCha20-Poly1305 + SHA-256/HMAC/HKDF + RDRAND) -- self-contained, no
# external crypto library and no C-runtime/relbase baggage, so the module
# links against nothing beyond the base AROS libs.
#MM- workbench-libs : workbench-libs-credentials
%build_module mmake=workbench-libs-credentials \
    modname=credentials modtype=library \
    files="credentials_init $(FILES)"

#MM includes-copy
INCLUDE_FILES := $(call WILDCARD, include/*.h)
%copy_includes path=libraries dir=include

%common
