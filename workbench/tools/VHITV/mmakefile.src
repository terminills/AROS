include $(SRCDIR)/config/aros.cfg

#MM- workbench-tools : workbench-tools-vhitv workbench-tools-vhitv-icon
#MM- workbench-tools-vhitv : workbench-libs-vhi-uvc
# The client dispatches through an explicitly opened VHI driver base and uses
# only the public compiler/include/vhi/vhi.h ABI.

%build_prog mmake=workbench-tools-vhitv \
    progname=VHITV \
    files=VHITV \
    targetdir=$(AROS_TOOLS)

%build_icons mmake=workbench-tools-vhitv-icon icons=VHITV \
    dir=$(AROS_TOOLS) srcdir=$(SRCDIR)/$(CURDIR)/icons

%common
