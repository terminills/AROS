/* Mountlist entry for the unlimited source of NUL bytes (just a handler) */
ZERO:
	EHandler	= nil-handler
	Activate	= 1
#

ROOT:
	EHandler	= rootfs-handler
	Activate	= 1
#

/* Entry for a file mounted as filesystem AFD0: */
AFD0:
	FileSystem	= afs-handler
	Device		= fdsk.device
	Unit		= 0
	BlockSize	= 512
	Surfaces	= 2
	BlocksPerTrack	= 11
	LowCyl		= 0
	HighCyl		= 79
	Reserved	= 2
	Activate	= 1
#

