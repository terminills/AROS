# wpa_supplicant build configuration for AROS (C:WirelessManager)
#
# The SANA-II driver backend talks to a hard-MAC wireless device; the only
# I/O is the device, so there is no control interface, no D-Bus and no
# sockets. See src/drivers/driver_sana2.c for the device contract.

CONFIG_DRIVER_SANA2=y

# IEEE 802.1X/EAPOL supplicant (the 4-way handshake needs it; no EAP methods)
CONFIG_IEEE8021X_EAPOL=y

# WPA3-Personal. Management frame protection (IEEE 802.11w) is always built
# in this version; SAE needs elliptic curves, which the internal crypto
# backend lacks: CONFIG_EC_MBEDTLS adds them from the SDK's libmbedcrypto.
CONFIG_SAE=y
CONFIG_EC_MBEDTLS=y

# WEP is still offered by some devices
CONFIG_WEP=y

# Configuration from a text file, read-only
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y

# AmigaOS/MorphOS/AROS program entry, OS wrapper and event loop
CONFIG_MAIN=main_amiga
CONFIG_OS=amiga
CONFIG_ELOOP=eloop_amiga

# EAPOL frames go through the SANA-II backend, not a packet socket
CONFIG_L2_PACKET=sana2

# Internal TLS/crypto implementation (no OpenSSL on AROS)
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y

# Not built: wpa_cli (needs the control interface) and wpa_passphrase
CONFIG_NO_WPA_PASSPHRASE=y
CONFIG_NO_GITVER=y
