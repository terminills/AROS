#
#MM- test : test-smp
#MM- test-quick : test-smp-quick
#
#MM- test-smp : test-smp-pthread test-smp-latency test-smp-stress test-smp-trace test-smp-smp test-smp-smp-smallpt test-smp-preempt test-smp-sigrace test-smp-sem test-smp-sched test-smp-doio test-smp-lists test-smp-clock test-smp-proc test-smp-affinity test-smp-condvar test-smp-multiwake test-smp-tlb test-smp-exitrace test-smp-timerjitter test-smp-semstorm
#MM- test-smp-quick : test-smp-pthread-quick test-smp-latency-quick test-smp-stress-quick test-smp-trace-quick test-smp-smp-quick test-smp-smp-smallpt-quick test-smp-preempt-quick test-smp-sigrace-quick test-smp-sem-quick test-smp-sched-quick test-smp-doio-quick test-smp-lists-quick test-smp-clock-quick test-smp-proc-quick test-smp-affinity-quick test-smp-condvar-quick test-smp-multiwake-quick test-smp-tlb-quick test-smp-exitrace-quick test-smp-timerjitter-quick test-smp-semstorm-quick

include $(SRCDIR)/config/aros.cfg

EXEDIR := $(AROS_TESTS)/smp

USER_CFLAGS := $(PARANOIA_CFLAGS)

%build_prog mmake=test-smp-pthread \
    files=smppthread targetdir=$(EXEDIR) \
    progname=SMP-PThread \
    uselibs="pthread"

%build_prog mmake=test-smp-exitrace \
    files=smpexitrace targetdir=$(EXEDIR) \
    progname=SMP-ExitRace \
    uselibs="pthread"

%build_prog mmake=test-smp-semstorm \
    files=smpsemstorm targetdir=$(EXEDIR) \
    progname=SMP-SemStorm

%build_prog mmake=test-smp-timerjitter \
    files=smptimerjitter targetdir=$(EXEDIR) \
    progname=SMP-TimerJitter

%build_prog mmake=test-smp-latency \
    files=smplatency targetdir=$(EXEDIR) \
    progname=SMP-Latency

%build_prog mmake=test-smp-stress \
    files=smpstress targetdir=$(EXEDIR) \
    progname=SMP-Stress

%build_prog mmake=test-smp-trace \
    files=smptrace targetdir=$(EXEDIR) \
    progname=SMP-Trace

%build_prog mmake=test-smp-preempt \
    files=smppreempt targetdir=$(EXEDIR) \
    progname=SMP-Preempt

%build_prog mmake=test-smp-sigrace \
    files=smpsigrace targetdir=$(EXEDIR) \
    progname=SMP-SigRace

%build_prog mmake=test-smp-sem \
    files=smpsem targetdir=$(EXEDIR) \
    progname=SMP-Sem

%build_prog mmake=test-smp-sched \
    files=smpsched targetdir=$(EXEDIR) \
    progname=SMP-Sched

%build_prog mmake=test-smp-doio \
    files=smpdoio targetdir=$(EXEDIR) \
    progname=SMP-DoIO

%build_prog mmake=test-smp-lists \
    files=smplists targetdir=$(EXEDIR) \
    progname=SMP-Lists

%build_prog mmake=test-smp-clock \
    files=smpclock targetdir=$(EXEDIR) \
    progname=SMP-Clock

%build_prog mmake=test-smp-proc \
    files=smpproc targetdir=$(EXEDIR) \
    progname=SMP-Proc

%build_prog mmake=test-smp-affinity \
    files=smpaffinity targetdir=$(EXEDIR) \
    progname=SMP-Affinity

%build_prog mmake=test-smp-condvar \
    files=smpcondvar targetdir=$(EXEDIR) \
    progname=SMP-CondVar uselibs="pthread"

%common

%build_prog mmake=test-smp-multiwake \
    files=smpmultiwake targetdir=$(EXEDIR) \
    progname=SMP-MultiWake \
    uselibs="pthread"

%build_prog mmake=test-smp-tlb \
    files=smptlb targetdir=$(EXEDIR) \
    progname=SMP-TLB \
    uselibs="pthread"
