include $(SRCDIR)/config/aros.cfg

BASEICONS := Clock Help Installer More MultiView

#MM- iconset-Ion-wbench-icons-aros-clean : iconset-Ion-wbench-icons-aros-utilities-clean
#MM- iconset-Ion-wbench-icons-aros : iconset-Ion-wbench-icons-aros-utilities

%build_icons mmake=iconset-Ion-wbench-icons-aros-utilities icons=$(BASEICONS) \
             dir=$(AROS_UTILITIES)

#MM- icons-wbench-utilities : ion-icons-wbench-utilities
%build_icons mmake=ion-icons-wbench-utilities icons=$(BASEICONS) \
             dir=$(AROS_PRESETS)/Icons/Ion/Default/$(AROS_DIR_AROS)/$(AROS_DIR_UTILITIES)
