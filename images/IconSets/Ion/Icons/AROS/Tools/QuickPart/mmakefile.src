include $(SRCDIR)/config/aros.cfg

#MM- iconset-Ion-wbench-icons-aros-tools-clean : iconset-Ion-wbench-icons-aros-tools-quickpart-clean
#MM- iconset-Ion-wbench-icons-aros-tools : iconset-Ion-wbench-icons-aros-tools-quickpart

%build_icons mmake=iconset-Ion-wbench-icons-aros-tools-quickpart icons=QuickPart \
             dir=$(AROS_TOOLS)/QuickPart

#MM- icons-wbench-tools : ion-icons-wbench-tools-quickpart
%build_icons mmake=ion-icons-wbench-tools-quickpart icons=QuickPart \
             dir=$(AROS_PRESETS)/Icons/Ion/Default/$(AROS_DIR_AROS)/$(AROS_DIR_TOOLS)/QuickPart
