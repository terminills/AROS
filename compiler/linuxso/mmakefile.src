#   Copyright (C) 2026, The AROS Development Team. All rights reserved.
#
#   linuxso: static link library that maps Linux x86-64 ELF shared objects
#   (ET_DYN) into an AROS process and serves their glibc imports.

include $(SRCDIR)/config/aros.cfg

# x86-64 only: the objects it loads are x86-64 code and lso_syscall_tramp.S
# is 64-bit assembly, so it cannot be built for any other CPU (the i386
# regression build failed on it, 2026-09-21). It must not sit under
# core-linklibs, which every module build depends on; hang it off the
# per-CPU linklibs metatarget instead (cf. arch/arm-all/arm-aeabi). Users
# such as cef-blink name it in uselibs and pull linklibs-linuxso directly.
#MM- linklibs-x86_64 : linklibs-linuxso
#MM linklibs-linuxso : includes linuxso-includes-copy

#MM- includes-copy : linuxso-includes-copy
#MM- compiler-includes : linuxso-includes-copy

%copy_includes mmake=linuxso-includes-copy includes="linuxso.h"

LINUXSOFILES := \
    lso_elf \
    lso_task \
    lso_pthread \
    lso_file \
    lso_mem \
    lso_shim \
    lso_syscall

%build_linklib mmake=linklibs-linuxso \
    libname=linuxso \
    files="$(LINUXSOFILES)" \
    asmfiles="lso_syscall_tramp"

#MM- test-linuxso : linklibs-linuxso linklibs-pthread

%build_prog mmake=test-linuxso \
    progname=LinuxSO targetdir=$(AROS_TESTS) \
    files="linuxso_cli" uselibs="linuxso pthread"
