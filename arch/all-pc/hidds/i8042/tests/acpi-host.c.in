#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
typedef uintptr_t IPTR;
typedef uint32_t ULONG;
typedef uint32_t ACPI_STATUS;
typedef void *ACPI_HANDLE;
typedef void *APTR;
typedef int OOP_Object;
typedef int OOP_Class;
typedef void (*OOP_MethodFunc)(void);
struct Library {int lib_OpenCnt;};
struct i8042base {
    struct Library library;
    struct {
        unsigned cs_Flags; OOP_Object *kbdhw,*mousehw;
        OOP_Class *kbdclass,*mouseclass,*kbdPushEvent_Class,*mousePushEvent_Class;
        OOP_MethodFunc kbdPushEvent,mousePushEvent;
        struct Library *cs_OOPBase; IPTR hiddAttrBase,hwMethodBase,hwInputMethodBase;
    } csd;
};
#define LIBBASETYPEPTR struct i8042base *
#define D(x)
#define ReturnInt(name,type,val) return val
#define TRUE 1
#define FALSE 0
#define AE_OK 0
#define ACPI_FAILURE(status) ((status)!=0)
#define USE_FAST_PUSHEVENT 1
#define PS2F_DISABLEKEYB 1
#define PS2F_DISABLEMOUSE 2
#define CLID_HW_Kbd "keyboard"
#define CLID_HW_Mouse "mouse"
#define moHW_Input_PushEvent 1
#define ADD2INITLIB(fn,priority) static const int priority_##fn = priority;
static struct Library acpi;
static OOP_Object keyboard,mouse;
static OOP_Class kbdclass,mouseclass;
static int devices,acpi_present,added_kbd,added_mouse;
static struct Library *OpenLibrary(const char *name,int v) {return acpi_present ? &acpi : NULL;}
static void CloseLibrary(struct Library *l) {assert(l==&acpi);}
static ACPI_STATUS AcpiGetDevices(const char *id,
    ACPI_STATUS (*cb)(ACPI_HANDLE,ULONG,void *,void **),void *ctx,void **result) {
    int flag=!strcmp(id,"PNP0303") ? 1 : 2;
    return (devices & flag) ? cb(NULL,0,ctx,result) : AE_OK;
}
static OOP_Object *OOP_NewObject(void *cl,const char *id,void *tags) {
    return !strcmp(id,CLID_HW_Kbd) ? &keyboard : &mouse;
}
static void event(void) {}
static OOP_MethodFunc OOP_GetMethod(OOP_Object *o,IPTR id,OOP_Class **cl) {
    *cl=o==&keyboard ? &kbdclass : &mouseclass; return event;
}
static OOP_Object *HW_AddDriver(OOP_Object *o,OOP_Class *cl,void *tags) {
    if(o==&keyboard) added_kbd++; else added_mouse++;
    return o;
}
@ACPI@
@CLASSINIT@
/* Execute the source-registered INITLIB callbacks in symbol-set priority order.
 * Attribute/class setup is mocked; the probe and registration functions are real. */
static int init(struct i8042base *b) {
    if(priority_i8042_acpi_probe < priority_i8042_Init)
        return i8042_acpi_probe(b) && i8042_Init(b);
    return i8042_Init(b) && i8042_acpi_probe(b);
}
int main(void) {
    for(int scenario=0;scenario<5;scenario++) {
        struct i8042base b={0};
        added_kbd=added_mouse=0;
        acpi_present=scenario!=4; devices=scenario & 3;
        int ok=init(&b);
        if(scenario==0) {
            assert(!ok && !added_kbd && !added_mouse);
        } else {
            assert(ok);
            assert(added_kbd==((devices&1)!=0 || !acpi_present));
            assert(added_mouse==((devices&2)!=0 || !acpi_present));
        }
    }
    puts("PASS ACPI no-device failure before driver registration, keyboard-only, mouse-only, both and absent ACPI");
}
